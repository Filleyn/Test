<?xml version="1.0" encoding="utf-8"?>
<!-- Android's automatic backup (Android 12 and newer); see backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="satellite" />
        <exclude domain="file" path="photos" />
        <exclude domain="file" path="fires" />
        <exclude domain="file" path="maps" />
        <exclude domain="file" path="weather.json" />
        <exclude domain="file" path="search" />
        <exclude domain="file" path="last-crash.txt" />
        <exclude domain="file" path="last-exit-seen.txt" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="satellite" />
        <exclude domain="file" path="maps" />
        <exclude domain="file" path="search" />
    </device-transfer>
</data-extraction-rules>
